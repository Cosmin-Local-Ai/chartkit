{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChartKit",
  "version": "0.1.0",
  "identifier": "app.chartkit",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "ChartKit",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist": "ui"
    },
    "shortDescription": "Local chart and order-flow workspace",
    "longDescription": "ChartKit stores candle history and order-flow prints in a local SQLite database and serves its own web client over loopback, so it works offline and needs no account.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"]
      }
    }
  }
}
