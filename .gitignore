# Rust build artifacts — rebuilt by cargo, never committed
/target/
crates/*/target/

# Front-end dependencies and the built bundle the server serves
node_modules/
ui/node_modules/
ui/dist/

# Local data: the SQLite store, its WAL sidecars, and any scratch db
*.db
*.db-wal
*.db-shm
*.sqlite

# Tauri bundle output (the Windows installer is built in CI)
desktop/*/target/
desktop/*/gen/schemas/

# Editor and OS noise
.DS_Store
*.log
.idea/
.vscode/
